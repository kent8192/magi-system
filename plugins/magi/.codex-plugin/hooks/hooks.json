            "statusMessage": "Registering magi Codex agent"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/magi-codex-app-server-ensure.sh\"",
            "timeout": 30,
            "statusMessage": "Ensuring Codex app-server"
          },
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/magi-codex-prompt-context.sh\"",
            "timeout": 300,
            "statusMessage": "Loading magi context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/magi-codex-app-server-ensure.sh\"",
            "timeout": 30,
            "statusMessage": "Ensuring Codex app-server"
          }
