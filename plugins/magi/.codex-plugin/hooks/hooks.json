{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/magi-codex-app-server-ensure.sh\"",
            "timeout": 30,
            "statusMessage": "Ensuring Codex app-server"
          },
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/magi-codex-session-start.sh\"",
