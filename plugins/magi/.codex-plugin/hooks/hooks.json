{
  "description": "Codex session-scoped magi agent lifecycle.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/magi-codex-session-start.sh\"",
            "timeout": 300,
            "statusMessage": "Registering magi Codex agent"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/magi-codex-prompt-context.sh\"",
            "timeout": 300,
            "statusMessage": "Loading magi context"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/magi-codex-session-end.sh\"",
            "timeout": 300,
            "statusMessage": "Cleaning up magi Codex agent"
          }
        ]
      }
    ]
  }
}
